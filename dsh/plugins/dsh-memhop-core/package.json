{
  "name": "@deepseek-ai/dsh-memhop-core",
  "description": "MemHop memory subsystem for DSH: control-plane service over the registered mcp__memhop__* tools — automatic search/update/dream lifecycle, snapshot cache, and status/statistics for UI plugins.",
  "version": "0.1.0",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/harness/memhop-core"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "harness": {
      "inject": ["tools", "systemPrompt", "settings"]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node --check lib/index.js"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-tools": "workspace:^",
    "@deepseek-ai/dsh-system-prompt": "workspace:^"
  }
}
