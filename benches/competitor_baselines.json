  "memhop": {
    "name": "MemHop",
    "repo": "https://github.com/meow/memhop",
    "architecture": "L0-L5 cognitive layers, BM25(0.5) + Vector(0.35) + Entity(0.15) hybrid, Hypergraph L3, Dream consolidation",
    "deployment": "Embedded Rust cdylib, zero external dependencies",
    "benchmarks": {
      "locomo": {
        "test_dataset": "LOCOMO full dataset",
        "queries": 1986,
        "sessions": 272,
        "vector_model": "multilingual-e5-small",
        "retrieval_metrics": {
          "recall_at_1": 0.006,
          "recall_at_5": 0.282,
          "recall_at_10": 0.563,
          "mrr": 0.153,
          "ndcg_at_10": 0.235
        },
        "latency": {
          "p50_ms": 121,
          "p95_ms": 230,
          "p99_ms": 397
        },
        "throughput": {
          "qps": 7.4,
          "ingestion_items_per_sec": 9.4
        },
        "source": "e2e_benchmark, 2026-06-30",
        "notes": "Metrics are retrieval recall rates, not LLM-judge accuracy. Latency includes Python gRPC vector encoding overhead."
      },
      "longmemeval": {"score": null, "metric": "accuracy", "source": "to be measured"}
    },
    "unique_advantages": [
      "Zero-dependency embedded deployment (no Docker/Neo4j/Qdrant required)",
      "Rust performance with SIMD-accelerated vector search (AVX2/NEON)",
      "6-layer cognitive architecture (L0 Profile → L5 Crystal)",
      "Dream consolidation with LLM-driven memory pruning",
      "Time-decay mechanism for memory relevance",
      "Sub-millisecond BM25 search via inverted index"
    ]
  }
